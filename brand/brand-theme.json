    "rgbaPatterns": {
      "borderSubtle": "rgba(44, 37, 32, 0.07)",
      "borderDefault": "rgba(44, 37, 32, 0.12)",
      "borderHover": "rgba(44, 37, 32, 0.18)",
      "cardHoverShadow": "rgba(44, 37, 32, 0.1)",
      "logoBadgeShadow": "rgba(44, 37, 32, 0.3)",
      "particleFill": "rgba(44, 37, 32, variable alpha 0.076-0.336)",
