      "c3": {
        "hex": "#2C2520",
        "name": "Dark Brown",
        "role": "Primary text, logo badge, dark buttons, card icon backgrounds, active filters, headlines"
      }
    },
    "extended": {
      "blobTan": { "hex": "#DFCDB9", "role": "Bottom-left ambient blob" },
