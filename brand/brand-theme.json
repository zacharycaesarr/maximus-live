  "cssVariables": {
    "--c0": "#FCFAF2",
    "--c1": "#F5F0E6",
    "--c2": "#D9C3B0",
    "--c3": "#2C2520",
    "--ff-disp": "'Playfair Display', Georgia, serif",
    "--ff-body": "'Inter', system-ui, sans-serif",
    "--ff-mono": "'DM Mono', 'Courier New', monospace",
    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-elastic": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "typography": {
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,900;1,400;1,900&family=Inter:wght@200;300;400;500&family=DM+Mono:wght@300;400&display=swap",
    "families": {
      "display": {
        "name": "Playfair Display",
        "variable": "--ff-disp",
        "weights": [400, 600, 900],
        "italics": [400, 900],
        "usage": "Headlines, hero titles, card values, section headings, portfolio card titles"
      },
      "body": {
        "name": "Inter",
        "variable": "--ff-body",
        "weights": [200, 300, 400, 500],
        "usage": "Body copy, subcopy, service line, deliverable text"
      },
      "mono": {
        "name": "DM Mono",
        "variable": "--ff-mono",
        "weights": [300, 400],
        "usage": "Section labels, nav, filters, badges, footer, buttons, stat counter"
      }
    },
    "opacityTiers": {
      "primary": 1.0,
      "body": 0.58,
      "subcopy": 0.52,
      "muted": 0.45,
      "secondary": 0.42,
      "label": 0.36,
      "disclaimer": 0.72,
      "tagline": 0.28
    },
    "scale": {
      "heroTitle": "clamp(68px, 12vw, 156px)",
      "contactHeadline": "clamp(44px, 7vw, 100px)",
      "portfolioHero": "clamp(40px, 7vw, 88px)",
      "workTeaserHeadline": "clamp(36px, 6vw, 72px)",
      "aboutHero": "clamp(42px, 7vw, 78px)",
      "sectionHeadline": "clamp(28px, 4.5vw, 44px)",
      "bottomCta": "clamp(28px, 5vw, 48px)",
      "cardValue": "26px",
      "body": "15px",
      "subcopy": "14px",
      "sectionLabel": "10-10.5px",
      "nav": "10.5px",
      "filterPill": "10px",
      "badge": "9-9.5px",
      "button": "11px",
      "footer": "10.5px",
      "statNumber": "clamp(64px, 12vw, 108px)"
    }
  },
  "logo": {
    "primaryAsset": "assets/mm-logo.svg",
    "badgeBackground": "#2C2520",
