      "mockFitness": { "hex": "#1A1614", "role": "Work teaser dark mock" },
      "mockRestaurant": { "hex": "#3D3530", "role": "Work teaser dark mock" },
      "mockMedSpa": { "hex": "#E8DDD4", "role": "Work teaser light mock" }
