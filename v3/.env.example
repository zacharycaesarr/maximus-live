# Copy to .env.local and fill in from Supabase → Project Settings → API
# Vite only exposes vars that start with VITE_

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Stripe Payment Link (optional fallback)
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxx

# Stripe Elements (in-portal card form) — publishable only
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret key goes in Supabase Edge Function secret: STRIPE_SECRET_KEY

# Optional override for bank/ACH (defaults to PayPal NCP link in code)
# VITE_ACH_PAYMENT_LINK=https://www.paypal.com/ncp/payment/...

# Cal.com booking page (optional; embed uses calLink in code)
# VITE_CAL_COM_URL=https://cal.com/zachary-maximus-ambrcs/booking
